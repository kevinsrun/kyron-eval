        "type": "string"
      },
      "initial_state": {
        "$ref": "#/$defs/SystemState"
      },
      "tools": {
        "$ref": "#/$defs/ToolBehavior"
      },
      "policy_id": {
        "title": "Policy Id",
        "type": "string"
      },
      "policy_version": {
        "title": "Policy Version",
        "type": "string"
      },
      "expected": {
        "$ref": "#/$defs/Expectations"
      },
