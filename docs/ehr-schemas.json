{
  "Scenario": {
    "$defs": {
      "AppointmentSlot": {
        "additionalProperties": false,
        "properties": {
          "slot_id": {
            "minLength": 1,
            "title": "Slot Id",
            "type": "string"
          },
          "provider_id": {
            "minLength": 1,
            "title": "Provider Id",
            "type": "string"
          },
          "location_id": {
            "minLength": 1,
            "title": "Location Id",
            "type": "string"
          },
          "starts_at": {
            "format": "date-time",
            "title": "Starts At",
            "type": "string"
          },
          "ends_at": {
            "format": "date-time",
            "title": "Ends At",
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/AvailabilityKind"
          }
        },
        "required": [
          "slot_id",
          "provider_id",
          "location_id",
          "starts_at",
          "ends_at",
          "kind"
        ],
        "title": "AppointmentSlot",
        "type": "object"
      },
      "AvailabilityKind": {
        "enum": [
          "OPEN",
          "SAME_DAY",
          "CANCELLATION",
          "SHORT_VISIT",
          "ALTERNATIVE_PROVIDER",
          "NEXT_AVAILABLE",
          "TELEHEALTH"
        ],
        "title": "AvailabilityKind",
        "type": "string"
      },
      "Booking": {
        "additionalProperties": false,
        "properties": {
          "appointment_id": {
            "title": "Appointment Id",
            "type": "string"
          },
          "patient_id": {
            "title": "Patient Id",
            "type": "string"
          },
          "slot": {
            "$ref": "#/$defs/AppointmentSlot"
          },
          "confirmation_event_id": {
            "title": "Confirmation Event Id",
            "type": "string"
          }
        },
        "required": [
          "appointment_id",
          "patient_id",
          "slot",
          "confirmation_event_id"
        ],
        "title": "Booking",
        "type": "object"
      },
      "CallerTurn": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "facts": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Facts",
            "type": "object"
          },
          "confirms_offer": {
            "default": false,
            "title": "Confirms Offer",
            "type": "boolean"
          },
          "confirms_cancellation": {
            "default": false,
            "title": "Confirms Cancellation",
            "type": "boolean"
          },
          "elapsed_seconds": {
            "default": 0,
            "minimum": 0,
            "title": "Elapsed Seconds",
            "type": "integer"
          }
        },
        "required": [
          "text"
        ],
        "title": "CallerTurn",
        "type": "object"
      },
      "Disposition": {
        "enum": [
          "EMERGENCY",
          "URGENT_SAME_DAY",
          "SOON",
          "ROUTINE",
          "ADMINISTRATIVE",
          "HUMAN_REVIEW"
        ],
        "title": "Disposition",
        "type": "string"
      },
      "Expectations": {
        "additionalProperties": false,
        "properties": {
          "acceptable_outcomes": {
            "items": {
              "enum": [
                "BOOKED",
                "NOT_BOOKED",
                "EMERGENCY",
                "REVIEW_QUEUED"
              ],
              "type": "string"
