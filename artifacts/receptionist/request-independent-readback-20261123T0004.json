  "actual_agent_speech": [
    {
      "id": "e0005",
      "text": "Hello! Thanks for calling the clinic. "
    },
    {
      "id": "e0006",
      "text": "I'm the AI scheduling assistant. "
    },
    {
      "id": "e0009",
      "text": "May I have your full name and date of birth, please?"
    },
    {
      "id": "e0014",
      "text": "Thanks, one second."
    },
    {
      "id": "e0020",
      "text": "Thank you. For an additional identity check, could you please provide the phone number we have on your record?"
    },
    {
      "id": "e0027",
      "text": "Got it, thank you."
    },
    {
      "id": "e0038",
      "text": "I've found one appointment for you on November 25th, 2026, from 3:00 PM to 3:30 PM UTC with Avery Brooks at the Willow Creek Clinic. "
    },
    {
      "id": "e0040",
      "text": "How can I help you with this? "
    },
    {
      "id": "e0044",
      "text": "You can view or keep the appointment, request a new one, reschedule, or cancel, though any changes will need to be confirmed by the clinic scheduling team."
    },
    {
      "id": "e0051",
      "text": "Let me check on that."
    },
    {
      "id": "e0055",
      "text": "I've noted you'd like an annual wellness visit for next Tuesday morning. "
    },
    {
      "id": "e0058",
      "text": "Do you have a preference for a specific clinician or whether the visit is in-person or virtual? "
    },
    {
      "id": "e0061",
      "text": "Just so you know, the clinic will need to confirm the final time."
    },
    {
      "id": "e0064",
      "text": "Thanks, one moment."
    },
    {
      "id": "e0075",
      "text": "I've noted your preferences, but I can't confirm a time or make changes here. "
    },
    {
      "id": "e0078",
      "text": "Please contact the clinic's scheduling team to finalize your appointment. "
    },
    {
      "id": "e0080",
      "text": "Thank you for calling, and have a great day!"
    }
